# MySQL 연결 문자열 (docker-compose 기본값 기준)
DATABASE_URL=mysql+pymysql://appuser:apppassword@localhost:3306/authdb

# JWT 설정 — 반드시 안전한 랜덤 값으로 교체할 것 (예: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
